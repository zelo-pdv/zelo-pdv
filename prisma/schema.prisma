generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  DINHEIRO
  PIX
  CARTAO_DE_CREDITO
  CARTAO_DEBITO
  FIADO
}

enum SaleStatus {
  PAGO
  PENDENTE
  CANCELADO
}

model Loja {
  id        String  @id @default(cuid())
  name      String  @unique
  ownerName String
  phone     String?
  email     String? @unique
  document  String?
  logo      String?
  active    Boolean @default(true)

  address      Address[]
  users        User[]
  accessGroups AccessGroup[]
  clients      Client[]
  categories   Category[]
  units        Unit[]
  products     Product[]
  sales        Sale[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Address {
  id           String  @id @default(cuid())
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([lojaId])
  @@index([userId])
  @@index([clientId])
}

model AccessGroup {
  id          String  @id @default(cuid())
  name        String
  description String?
  active      Boolean @default(true)
  permissions Json

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  users User[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([lojaId, name])
  @@index([lojaId])
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  phone     String?
  avatar    String?
  active    Boolean   @default(true)
  lastLogin DateTime?

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  groupId String
  group   AccessGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  address Address[]
  sales   Sale[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([lojaId])
  @@index([groupId])
}

model Client {
  id    String  @id @default(cuid())
  name  String
  phone String
  email String?
  notes  String?
  active Boolean @default(true)

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  address Address[]
  sales   Sale[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([lojaId])
  @@index([lojaId, active])
  @@index([lojaId, updatedAt])
  @@index([lojaId, deletedAt])
}

model Unit {
  id           String @id @default(cuid())
  name         String
  abbreviation String
  decimalPlaces Int     @default(0)

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lojaId, name])
  @@unique([lojaId, abbreviation])
  @@index([lojaId])
}

model Category {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([lojaId, name])
  @@index([lojaId])
  @@index([lojaId, updatedAt])
}

model Product {
  id          String  @id @default(cuid())
  code        String?
  barcode     String?
  name        String
  description String?
  image       String?
  unit        String  @default("UN")
  costPrice   Decimal @default(0.00) @db.Decimal(10, 2)
  salePrice   Decimal @db.Decimal(10, 2)
  stock       Decimal @default(0) @db.Decimal(10, 3)
  minStock    Decimal @default(0) @db.Decimal(10, 3)
  notes       String?
  active      Boolean @default(true)

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  saleItems SaleItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([lojaId, code])
  @@index([lojaId])
  @@index([lojaId, active])
  @@index([lojaId, barcode])
  @@index([lojaId, updatedAt])
  @@index([lojaId, deletedAt])
}

model Sale {
  id            String        @id @default(cuid())
  saleNumber    Int?
  date          DateTime      @default(now())
  total         Decimal       @db.Decimal(10, 2)
  discount      Decimal?      @default(0.00) @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(PAGO)
  dueDate       DateTime?
  notes         String?

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  clientName String?

  sellerId String?
  seller   User?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  items SaleItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([lojaId, saleNumber])
  @@index([lojaId])
  @@index([lojaId, date])
  @@index([lojaId, updatedAt])
  @@index([lojaId, deletedAt])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  productName String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([saleId])
  @@index([productId])
  @@index([updatedAt])
}
